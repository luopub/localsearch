# ==============================================================================
# LocalSearch — Git 排除规则
# ==============================================================================
# 先看清它和 .lsearchignore 的区别，两者解决的问题不同，规则不能互相照搬：
#
#   .gitignore      决定【哪些文件进版本库】—— 只关心源码与配置
#   .lsearchignore  决定【哪些文件进搜索索引】—— 关心全盘搜索时要跳过什么
#
# 所以这两份文件会给出相反的答案，这不是矛盾。最典型的是日志：
#   .gitignore 里要忽略 *.log（运行产物，不该入库）
#   .lsearchignore 里恰恰要保留（"那个报错在哪个日志里"正是要搜的东西）
#
# 也正因如此，本文件比 .lsearchignore 短得多——它不需要覆盖全盘的各种格式。
# ==============================================================================


# ---- 1. Python 环境（由 uv 管理，绝不入库）----
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/
build/
dist/
# 注意 .python-version 不忽略：uv 用它锁定解释器版本，属于项目定义的一部分


# ---- 2. 本项目的运行数据 ----
# data_dir 默认是 D:/localsearch-data/，位于仓库之外，git 本来就看不到它。
# 下面几条是防呆：万一有人把 data_dir 改到项目内部，几 GB 的索引库、向量文件和
# 模型缓存会一次性灌进版本库。
/localsearch-data/
data/
*.lsearch-tmp
*.lsearch-shm
*.lsearch-wal


# ---- 3. 配置：模板入库，本机配置不入库 ----
# config/default.toml  是模板，入库
# config/config.toml   含本机绝对路径（data_dir、roots 指向 D:/work、M:/docs），
#                      换台机器就没有意义，只会制造噪音 diff
config/config.toml


# ---- 4. 测试与静态检查的产物 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.coverage
.coverage.*
coverage.xml
htmlcov/


# ---- 5. 临时文件与调试残留 ----
*.log
*.tmp
*.bak
*.orig
*.rej
/tmp/
/scratch/
.tmp-*/
# P0 之后如产生体积较大的基准数据（吞吐原始输出、评测中间结果），
# 在这里追加对应目录的规则，不要把大文件直接提交进仓库


# ---- 6. 编辑器与工具的本机状态 ----
.vscode/
.idea/
*.swp
*.swo
*~
# settings.local.json 按命名约定就是"本机私有"，不入库；
# 同目录下的 settings.json 是共享配置，保留可入库
.claude/settings.local.json


# ---- 7. Windows 系统垃圾 ----
Thumbs.db
desktop.ini
ehthumbs.db
$RECYCLE.BIN/
*.lnk
~$*
